;【一、账本信息】
option "title" "我的账本" ;账本名称
option "operating_currency" "CNY" ;账本主货币

;【二、账户设置】
;1、开设账户

1990-01-01 open Assets:MyFavouriteBank:Cash CNY ;工资收入1
1990-01-01 open Assets:MyFavouriteBank:Caasdasdasdsad CNY ;工资收入2
1990-01-01 open Expenses:Groceries  CNY ;工资收入3


2024-02-15 * "Some transaction for Expenses:Groceries"
  Assets:MyFavouriteBank:Cash -37 CNY
  Expenses:Groceries 37 CNY

2024-02-15 * "Some transaction for Expenses:Groceries"
  Assets:MyFavouriteBank:Caasdasdasdsad -317 CNY
  Expenses:Groceries 317 CNY


;1、开设账户
1990-01-01 open Assets:Card:1234 CNY, USD ;尾号1234的银行卡，支持CNY和USD
1990-01-01 open Assets:Card:工商 CNY, USD ;尾号1234的银行卡，支持CNY和USD

1990-01-01 open Liabilities:CreditCard:5678 CNY, USD ;双币信用卡
1990-01-01 open Income:Salary CNY ;工资收入
1990-01-01 open Income:副业 CNY ;副业

1990-01-01 open Expenses:Tax车 CNY ;交税
1990-01-01 open Expenses:Traffic:Taxi CNY ;打车消费，只支持CNY
1990-01-01 open Equity:OpenBalance ;用于账户初始化，支持任意货币

;2、账户初始化
2019-08-27 * "" "银行卡，初始余额10000元"
    Assets:Card:1234           10000.00 CNY
    Equity:OpenBalance        -10000.00 CNY
2019-08-27 * "" "银行卡，初始余额10000元"
    Assets:Card:工商           20000.00 CNY
    Equity:OpenBalance        -20000.00 CNY
;【三、交易记录】
2019-08-28 * "杭州出租车公司" "打车到公司，银行卡支付"
    Expenses:Traffic:Taxi        200.00 CNY
    Liabilities:CreditCard:5678            -200.00 CNY

;【三、交易记录】
2019-08-28 * "杭州出租车公司" "打车到公司，银行卡支付"
    Expenses:Traffic:Taxi        200.00 CNY
    Assets:Card:1234            -200.00 CNY

2019-08-29 * "" "餐饮"
    Assets:Card:1234           -1100.00 CNY
    Liabilities:CreditCard:5678 1100.00 CNY
    
2019-08-31 * "XX公司" "工资收入"
    Assets:Card:1234           12000.00 CNY
    Expenses:Tax车                1000.00 CNY
    Income:Salary             

2019-08-31 * "XX公司" "工资收入"
    Assets:Card:工商           12000.00 CNY
    Income:副业           


2026-10-18 custom "budget" Assets:Card:1234 "MONTHLY" 22222 CNY






2026-10-18 custom "budget" Expenses:Groceries "MONTHLY" 999 CNY


2026-10-18 custom "budget" Assets:Card:1234 "MONTHLY" 111 CNY


2026-10-18 custom "budget" Assets:Card:1234 "MONTHLY" 222 CNY


2026-10-18 custom "budget" Assets:Card:1234 "MONTHLY" 123123 CNY

